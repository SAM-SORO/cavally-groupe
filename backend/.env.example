# ===========================================================================
# Outil interne — extraction Gemini + generation Excel
# ===========================================================================

# Cle API Google AI Studio. Ne jamais committer le fichier .env reel.
GEMINI_API_KEY=

# Modele Flash utilise pour l'extraction multimodale.
# Alias qui suit toujours le Flash courant : il ne tombera pas en 404 quand une
# version datee est retiree (ce qui est arrive a gemini-2.5-flash).
# Attention : le palier gratuit est limite a 20 requetes/jour/modele, et les
# alias « -latest » partagent le compteur du modele qu'ils designent.
GEMINI_MODEL=gemini-flash-latest

# Taille maximale acceptee pour un document uploade (Mo).
MAX_UPLOAD_MB=18

# Origines autorisees pour le front (separees par des virgules).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ===========================================================================
# Espace clients — base de donnees
# ===========================================================================

# PostgreSQL 17 local, base « cavally ». Seule la table des clients y vit.
DATABASE_URL=postgresql+psycopg://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/cavally


# ===========================================================================
# Espace clients — authentification
# ===========================================================================

# Secret de signature des jetons de session. A generer, par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHME=HS256
SESSION_DUREE_HEURES=12

# Passer a true des que le site est servi en HTTPS (cookie `Secure`).
COOKIE_SECURISE=false


# ===========================================================================
# Espace clients — relais WhatsApp (WhatsApp Cloud API)
# ===========================================================================
# Tant que TOKEN, PHONE_NUMBER_ID et DESTINATAIRE ne sont pas tous renseignes,
# l'envoi est SIMULE : il est journalise et le flux client aboutit normalement.
# Des que les trois sont fournis, l'envoi devient reel sans autre modification.

# Jeton d'acces permanent de l'application Meta.
WHATSAPP_TOKEN=

# Identifiant du numero expediteur (WhatsApp Business).
WHATSAPP_PHONE_NUMBER_ID=

# Numero de l'entreprise qui recoit les demandes, au format international
# sans « + » ni espaces. Exemple pour la Cote d'Ivoire : 2250797991999
WHATSAPP_DESTINATAIRE=

WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_URL=https://graph.facebook.com
